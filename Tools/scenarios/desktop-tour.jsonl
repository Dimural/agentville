// M4 desktop tour: release the crew first, then replay. Every activity pose with its particles (typing
// bits, Bash sparks, the telescope's twinkles, thinking dots), a sidekick with a "3" badge, a Done!
// cheer with confetti at 6 s, a Needs you run at 10 s, and a sleeper or coffee drinker once idle.
{"at": 0.0, "event": "UserPromptSubmit", "session": "tour-edit", "project": "api-server"}
{"at": 0.0, "event": "PreToolUse", "session": "tour-edit", "project": "api-server", "tool": "Edit"}

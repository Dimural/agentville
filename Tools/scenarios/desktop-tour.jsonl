{"at": 0.0, "event": "UserPromptSubmit", "session": "tour-done", "project": "blog"}
{"at": 0.0, "event": "PreToolUse", "session": "tour-done", "project": "blog", "tool": "Write"}
{"at": 0.0, "event": "UserPromptSubmit", "session": "tour-ask", "project": "dotfiles"}
